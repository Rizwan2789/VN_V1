# Local dev default targets the docker-compose Postgres service.
# In production, replace with the hosted connection string (e.g. Neon, Vercel Postgres) —
# app/core/config.py normalizes postgres:// / postgresql:// automatically, no code changes needed.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/vistanova_dev

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=["http://localhost:4200"]

# "log" (default) writes emails to the email_log table instead of sending.
# Set to "smtp" to actually send via the settings below.
EMAIL_BACKEND=log
EMAIL_FROM_ADDRESS=your-address@gmail.com

# Only needed when EMAIL_BACKEND=smtp. For Gmail: smtp_username is your full
# @gmail.com address, smtp_password is a 16-character App Password generated
# at https://myaccount.google.com/apppasswords (requires 2-Step Verification
# on the Google account) — your normal Gmail password will not work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
