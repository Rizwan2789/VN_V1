# Production values — copy to .env on the backend host (Render/Railway/Fly.io) and fill in.
# DATABASE_URL: hosted Postgres connection string (neon.tech, Supabase, RDS, etc.)
# core/config.py normalizes postgres:// / postgresql:// automatically — paste it verbatim.
DATABASE_URL=postgresql://user:password@your-hosted-postgres-host/dbname

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# The deployed Vercel frontend origin(s), no trailing slash.
CORS_ORIGINS=["https://your-app.vercel.app"]

# "log" (safe default) writes emails to the email_log table instead of sending.
# Set to "smtp" once the SMTP settings below are filled in.
EMAIL_BACKEND=log
EMAIL_FROM_ADDRESS=your-address@gmail.com

# Only read when EMAIL_BACKEND=smtp. Use a *separate* Gmail App Password from the
# one in local dev (generate at https://myaccount.google.com/apppasswords) so
# dev and prod can be revoked independently later.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
