# Production values — copy to .env on the backend host (Render/Railway/Fly.io) and fill in.
# DATABASE_URL: hosted Postgres connection string (Neon, Vercel Postgres, Supabase, RDS, etc.)
# core/config.py normalizes postgres:// / postgresql:// automatically — paste it verbatim.
DATABASE_URL=postgresql://user:password@your-hosted-postgres-host/dbname

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# The deployed Vercel frontend origin(s), no trailing slash.
CORS_ORIGINS=["https://your-app.vercel.app"]
